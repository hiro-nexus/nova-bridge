SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
NOVA_CHANNEL_ID=C...          # #nova-hub のチャンネルID
CONTEXT_CHANNEL_ID=           # #context のチャンネルID（空なら無効）
INBOX_CHANNEL_ID=             # #inbox のチャンネルID（空なら無効）
JOURNAL_CHANNEL_ID=           # #journal のチャンネルID（空なら、ジャーナルの返信の受け取りは無効）
SHORTCUT_BOTS=                # Webhook のボットIDとチャンネルIDの組。例: B0XXXX:C0YYYY,B0ZZZZ:C0WWWW（空なら Webhook 投稿は無視）
ALLOWED_USER_ID=U...          # Hiro のメンバーID
AGENT=claude_code
AGENT_WORKDIR=/home/hiro/obsidian-vault
# AGENT_MODEL=sonnet          # 省略時は sonnet
